{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/.next", "!**/dist", "!**/node_modules", "!**/*.css"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": { "noSvgWithoutTitle": "off", "useSemanticElements": "off" },
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noArrayIndexKey": "off", "noEmptyBlockStatements": "off" },
      "correctness": { "useExhaustiveDependencies": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
